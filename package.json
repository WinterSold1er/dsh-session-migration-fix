{
  "name": "dsh-session-migration-fix",
  "version": "0.2.0",
  "description": "DeepSeek Harness bundle plugin: fixes historical session format migration errors by stripping leaked signatures and normalizing unknown v0 historical events (such as orchestrate/change) during format restoration",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx/esm tests/index.test.ts"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-migration",
    "cordis"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session-persistence": "*"
  }
}
